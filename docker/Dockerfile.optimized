# syntax=docker/dockerfile:1-labs

# Build argument for custom certificates directory
ARG CUSTOM_CERT_DIR="certs"

# ============================================
# Stage 1: Node base image
# ============================================
FROM node:20-alpine3.22 AS node_base

# ============================================
# Stage 2: Node dependencies (with caching)
# ============================================
FROM node_base AS node_deps
WORKDIR /app

# Copy only package files first for better caching
COPY package.json package-lock.json ./

# Install dependencies with timeout and retry logic
RUN npm ci --legacy-peer-deps --loglevel=error --no-audit --no-fund \
    || (npm cache clean --force && npm ci --legacy-peer-deps --loglevel=error --no-audit --no-fund)

# ============================================
# Stage 3: Node builder
# ============================================
FROM node_base AS node_builder
WORKDIR /app

# Copy node_modules from deps stage
COPY --from=node_deps /app/node_modules ./node_modules

# Copy only necessary files for Next.js build
COPY package.json package-lock.json next.config.ts tsconfig.json tailwind.config.js postcss.config.mjs ./
COPY src/ ./src/
COPY public/ ./public/

# Build with increased memory and disabled telemetry
ENV NODE_OPTIONS="--max-old-space-size=4096"
ENV NEXT_TELEMETRY_DISABLED=1
RUN NODE_ENV=production npm run build

# ============================================
# Stage 4: Python dependencies
# ============================================
FROM python:3.11-slim AS py_deps
WORKDIR /app

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements and install
COPY api/requirements.txt ./api/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r api/requirements.txt

# ============================================
# Stage 5: Final production image
# ============================================
FROM python:3.11-slim AS production

# Set working directory
WORKDIR /app

# Install system dependencies more efficiently
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    git \
    ca-certificates && \
    # Add NodeSource repository
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && \
    # Install Node.js
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    # Clean up
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Handle custom certificates if provided
ARG CUSTOM_CERT_DIR
RUN if [ -n "${CUSTOM_CERT_DIR}" ] && [ -d "${CUSTOM_CERT_DIR}" ]; then \
        mkdir -p /usr/local/share/ca-certificates && \
        cp -r ${CUSTOM_CERT_DIR}/* /usr/local/share/ca-certificates/ 2>/dev/null || true && \
        update-ca-certificates; \
    fi

# Set Python path
ENV PATH="/opt/venv/bin:$PATH"

# Copy Python dependencies from builder
COPY --from=py_deps /opt/venv /opt/venv

# Copy API code
COPY api/ ./api/

# Copy Node.js application from builder
COPY --from=node_builder /app/public ./public
COPY --from=node_builder /app/.next/standalone ./
COPY --from=node_builder /app/.next/static ./.next/static

# Create test directory if it doesn't exist
RUN mkdir -p /app/test /app/test-results /app/test-reports

# Copy test files if they exist
COPY test/ ./test/ 2>/dev/null || true

# Copy pytest configuration
COPY pytest.ini ./pytest.ini 2>/dev/null || true

# Expose ports
EXPOSE ${PORT:-8001} 3000

# Create startup script
RUN cat > /app/start.sh << 'EOF'
#!/bin/bash
set -e

# Load environment variables from .env file if it exists
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

# Check for required environment variables
echo "Starting DeepWiki services..."
echo "Backend API Port: ${PORT:-8001}"
echo "Frontend Port: 3000 (mapped to 9001)"

if [ -z "$OPENAI_API_KEY" ] || [ -z "$GOOGLE_API_KEY" ]; then
  echo "Warning: API keys not set. Running in mock mode if USE_MOCK_EMBEDDINGS=true"
fi

# Start the API server in the background
echo "Starting backend API server..."
python -m api.main --port ${PORT:-8001} &
API_PID=$!

# Wait a moment for API to start
sleep 2

# Start the frontend server
echo "Starting frontend server..."
PORT=3000 HOSTNAME=0.0.0.0 node server.js &
FRONTEND_PID=$!

# Function to handle shutdown
shutdown() {
    echo "Shutting down services..."
    kill $API_PID $FRONTEND_PID 2>/dev/null || true
    exit 0
}

# Set up signal handlers
trap shutdown SIGTERM SIGINT

# Wait for any process to exit
wait -n

# Exit with the same status
exit $?
EOF

RUN chmod +x /app/start.sh

# Set environment variables
ENV PORT=8001
ENV NODE_ENV=production
ENV SERVER_BASE_URL=http://localhost:8001
ENV PYTHONUNBUFFERED=1

# Create empty .env file (will be overridden if one exists at runtime)
RUN touch .env

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8001}/health || exit 1

# Run the application
CMD ["/app/start.sh"]