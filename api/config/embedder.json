{
  "embedder": {
    "client_class": "GoogleEmbeddingClient",
    "batch_size": 500,
    "adaptive_retry": {
      "enabled": true,
      "max_retries": 3,
      "backoff_factor": 0.5,
      "min_batch_size": 32
    },
    "min_chunk_size": 150,
    "model_kwargs": {
      "model": "text-embedding-004"
    }
  },
  "retriever": {
    "top_k": 20
  },
  "text_splitter": {
    "split_by": "word",
    "chunk_size": 350,
    "chunk_overlap": 100
  }
}
